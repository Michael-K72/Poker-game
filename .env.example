# Environment template for MK Poker Royale
# Copy to apps/web/.env.local — NEVER commit real secrets.

# Auth (required) — long random string
BETTER_AUTH_SECRET=replace-with-long-random-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4001

# Database (optional — defaults to local SQLite file apps/web/data/mk-poker.db)
# DATABASE_URL=file:C:/path/to/mk-poker.db

# Email (password reset / verification — optional until SMTP configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
