# Environment template for MK Poker Royale
# Copy to apps/web/.env.local and apps/game-server/.env as needed.
# NEVER commit real secrets.

# Database (Phase 8+)
DATABASE_URL=postgresql://user:password@localhost:5432/mk_poker_royale

# Auth (Phase 8+)
AUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4001

# Email (Phase 8+)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
